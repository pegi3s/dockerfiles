FROM ubuntu:22.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable && \
    . "$HOME/.cargo/env" && \
    git clone https://github.com/AndreaGuarracino/paf2chain /opt/paf2chain && \
    cd /opt/paf2chain && \
    cargo build --release && \
    cp target/release/paf2chain /usr/local/bin/ && \
    rm -rf /opt/paf2chain/target "$HOME/.cargo/registry"

WORKDIR /data

