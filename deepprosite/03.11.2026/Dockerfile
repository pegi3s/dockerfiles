FROM ubuntu:20.04
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        git \
        wget \
        ca-certificates \
        build-essential \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/WeiLab-Biology/DeepProSite /opt/DeepProSite
WORKDIR /opt/DeepProSite/DeepProSite-main
RUN python3 -m pip install --no-cache-dir --upgrade \
        "pip==23.0.1" \
        "setuptools==59.5.0" \
        "wheel==0.37.1"
RUN python3 -m pip install --no-cache-dir \
        "typing_extensions==4.5.0" \
        "numpy==1.21.2"
RUN python3 -m pip install --no-cache-dir --no-deps \
        "torch==1.8.0+cpu" \
        --index-url https://download.pytorch.org/whl/cpu
RUN python3 -m pip install --no-cache-dir \
        "numpy==1.21.2" \
        "pandas==1.1.3" \
        "biopython==1.79" \
        "sentencepiece==0.1.96" \
        "transformers==4.15.0" \
        "tokenizers==0.10.3" \
        "huggingface_hub==0.4.0" \
        "scikit-learn==1.0.2" \
        "scipy==1.7.3" \
        "tqdm==4.62.3"
RUN mkdir -p pretrained_model/Rostlab/prot_t5_xl_uniref50 \
    && wget -q -O pretrained_model/Rostlab/prot_t5_xl_uniref50/config.json https://huggingface.co/Rostlab/prot_t5_xl_uniref50/resolve/main/config.json \
    && wget -q -O pretrained_model/Rostlab/prot_t5_xl_uniref50/spiece.model https://huggingface.co/Rostlab/prot_t5_xl_uniref50/resolve/main/spiece.model \
    && wget -q -O pretrained_model/Rostlab/prot_t5_xl_uniref50/tokenizer_config.json https://huggingface.co/Rostlab/prot_t5_xl_uniref50/resolve/main/tokenizer_config.json \
    && wget -q -O pretrained_model/Rostlab/prot_t5_xl_uniref50/special_tokens_map.json https://huggingface.co/Rostlab/prot_t5_xl_uniref50/resolve/main/special_tokens_map.json \
    && wget -q -O pretrained_model/Rostlab/prot_t5_xl_uniref50/pytorch_model.bin https://huggingface.co/Rostlab/prot_t5_xl_uniref50/resolve/main/pytorch_model.bin
RUN sed -i 's/\.cuda()/.to(device)/g' utils.py \
    && sed -i "s/torch.device('cuda')/torch.device('cpu')/g" utils.py \
    && sed -i 's/\.cuda()//g' edge_features.py self_attention.py \
    && sed -i 's/sub\[label_name\] = \[test_outputs/sub[label_name[0]] = [test_outputs/' utils.py \
    && chmod +x Software/dssp-2.0.4/mkdssp
RUN echo '' | base64 -d > /opt/DeepProSite/run_deepprosite.py
RUN echo '' | base64 -d > /opt/DeepProSite/deepprosite.sh \
    && chmod +x /opt/DeepProSite/deepprosite.sh
ENTRYPOINT ["/opt/DeepProSite/deepprosite.sh"]
