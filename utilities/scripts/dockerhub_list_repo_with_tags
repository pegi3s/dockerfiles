#!/bin/bash

display_usage() {
    echo -e "This script lists the tags for a given Docker Hub repository (user/image)."
    echo -e "\nUsage:"
    echo -e "\tUsage: `basename $0` <docker-hub-repository> [-jq=</path/to/jq>]"
}

if [[ $1 == "--help" ]]; then
    display_usage
    exit 0
fi

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    tput setaf 1
    echo -e "Error. This script requires one or two arguments.\n"
    tput sgr0
    display_usage
    exit 1
fi

REPOSITORY=$1

JQ=jq-linux64
CURL=curl

for key in "$@"
do
case $key in
    -jq=*|--jq=*)
    JQ="${key#*=}"
    shift
    ;;
    *)
      # unknown option
    ;;
esac
done

if ! [ -x "$(command -v $JQ)" ]; then
    tput setaf 1
    echo -e "Error. The jq executable is not available: $JQ.\n"
    tput sgr0
    exit 1
fi

if ! [ -x "$(command -v $CURL)" ]; then
    tput setaf 1
    echo -e "Error. The curl executable is not available: $CURL.\n"
    tput sgr0
    exit 1
fi

item=${REPOSITORY}

# Code to get tags from this gits: https://gist.github.com/robv8r/fa66f5e0fdf001f425fe9facf2db6d49
tokenUri="https://auth.docker.io/token"
data=("service=registry.docker.io" "scope=repository:$item:pull")
listUri="https://registry-1.docker.io/v2/$item/tags/list"

while : ; do
  token="$(curl --silent --get --data-urlencode ${data[0]} --data-urlencode ${data[1]} "$tokenUri" | $JQ --raw-output '.token')"
  tokenRC=$?
  if [ $tokenRC -eq 0 ] && [ -n "$token" ] && [ "$token" != "null" ]; then
    break
  fi
  sleep 60
done

while : ; do
  headerFile=$(mktemp)
  result="$(curl --silent -D "$headerFile" -H "Accept: application/json" -H "Authorization: Bearer $token" "$listUri")"
  HTTP_CODE=$(grep -oE '^HTTP/[0-9.]+ [0-9]{3}' "$headerFile" | tail -1 | awk '{print $2}')
  retryAfter=$(grep -i '^Retry-After:' "$headerFile" | tail -1 | tr -d '\r' | awk '{print $2}')
  rm -f "$headerFile"

  if [ "$HTTP_CODE" = "429" ]; then
    if [[ "$retryAfter" =~ ^[0-9]+$ ]]; then
      sleep $retryAfter
    else
      sleep 60
    fi
    continue
  fi
  break
done

if [ -n "$result" ] && echo "$result" | grep -q tags; then
  for tag in $(echo "$result" | $JQ -r '.tags[]'); do
    echo "$item:$tag"
  done
fi
