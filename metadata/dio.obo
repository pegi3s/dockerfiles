[Term]
id: DIO:0003642
name: Stable isotope dimethyl labelling
def: "Quantification analysis using chemical labeling by stable isotope dimethylation."
is_a: DIO:0003635

[Term]
id: DIO:0003643
name: Tag-based peptide identification
def: "Peptide sequence tags are used as piece of information about a peptide obtained by tandem mass spectrometry."
is_a: DIO:0003631

[Term]
id: DIO:0003644
name: de Novo sequencing
def: "Analytical process that derives a peptide&apos;s amino acid sequence from its tandem mass spectrum (MS/MS) without the assistance of a sequence database."
is_a: DIO:0000230
is_a: DIO:0003631

[Term]
id: DIO:0003645
name: PTM identification
