is_a: DIO:0002423

[Term]
id: DIO:0000256
name: Sequence feature comparison
def: "Compare the feature tables of two or more molecular sequences."
is_a: DIO:0002403
is_a: DIO:0002424

[Term]
id: DIO:0000258
name: Sequence alignment analysis
def: "Analyse a molecular sequence alignment."
is_a: DIO:0002403

[Term]
id: DIO:0000259
